{
  "name": "smart-hr",
  "version": "1.0.0",
  "private": true,
  "packageManager": "pnpm@10.30.0",
  "scripts": {
    "dev": "next dev",
    "predev": "node scripts/db-sync.mjs",
    "dev:clean": "node scripts/clean-dev.mjs && pnpm exec next dev",
    "dev:fresh": "node scripts/clean-dev.mjs && node scripts/db-sync.mjs && pnpm exec next dev",
    "build": "NODE_OPTIONS=--max-old-space-size=4096 next build",
    "prebuild": "node scripts/db-sync.mjs",
    "start": "next start",
    "prestart": "node scripts/db-sync.mjs",
    "lint": "eslint .",
    "db:sync": "node scripts/db-sync.mjs",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:migrate:deploy": "prisma migrate deploy",
    "db:push": "prisma db push",
    "db:seed": "tsx prisma/seed.ts",
    "db:purge-demo": "tsx scripts/purge-demo-data.mjs",
    "db:setup": "node scripts/db-sync.mjs && tsx prisma/seed.ts",
    "postinstall": "prisma generate"
  },
  "dependencies": {
    "@prisma/client": "^6.19.3",
    "bcryptjs": "^3.0.2",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "googleapis": "^173.0.0",
    "jose": "^6.0.12",
    "lucide-react": "^0.575.0",
    "next": "^16.2.12",
    "node-zklib": "^1.3.0",
    "nodemailer": "^9.0.3",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.5.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.2.2",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^25.5.0",
    "@types/nodemailer": "^8.0.1",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "eslint": "^9.39.4",
    "eslint-config-next": "^16.2.12",
    "prisma": "^6.19.3",
    "tailwindcss": "^4.2.2",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3"
  }
}
