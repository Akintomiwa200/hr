# Pooled URL for the app (include -pooler). Longer timeouts wake idle Neon computes.
DATABASE_URL="postgresql://USER:PASSWORD@ep-xxxx-pooler.REGION.aws.neon.tech/neondb?sslmode=require&connect_timeout=30&pool_timeout=30&pgbouncer=true"
# Direct URL for migrations (no -pooler).
DIRECT_URL="postgresql://USER:PASSWORD@ep-xxxx.REGION.aws.neon.tech/neondb?sslmode=require&connect_timeout=30&pool_timeout=30"
JWT_SECRET="smart-hr-dev-secret-change-in-production"

# Public app URL (optional). Leave unset on Vercel — the live host is auto-detected.
# Set only if you need a fixed canonical URL (custom domain, emails, OAuth).
# Dummy localhost values are ignored when the app is served from a real host.
APP_URL="http://localhost:3000"

# Check-in device / kiosk API key (optional master key for all devices)
ATTENDANCE_DEVICE_API_KEY="dev-attendance-device-master-key"

# SMTP — required for real inbox delivery (Gmail, Outlook, SendGrid, etc.)
# Without these, dev mode uses Ethereal test mail with a preview link in the API response.
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER="your-email@gmail.com"
SMTP_PASS="your-app-password"
SMTP_FROM="Smart HR <your-email@gmail.com>"

# Google Calendar & Meet (OAuth) — for interview scheduling
GOOGLE_CLIENT_ID="your-google-client-id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="your-google-client-secret"

# Zoho OAuth — People, Recruit, Books, Sign, Mail (single Zoho API client)
ZOHO_CLIENT_ID="your-zoho-client-id"
ZOHO_CLIENT_SECRET="your-zoho-client-secret"
# EU: https://accounts.zoho.eu | IN: https://accounts.zoho.in
ZOHO_ACCOUNTS_URL="https://accounts.zoho.com"
ZOHO_API_DOMAIN="https://www.zohoapis.com"

# Optional: protect POST /api/integrations/cron fallback polling
INTEGRATION_CRON_SECRET="change-me-in-production"
