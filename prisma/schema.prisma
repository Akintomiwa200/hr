generator client {
  provider = "prisma-client-js"
  engineType = "client"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Role {
  SUPER_ADMIN
  COMPANY_ADMIN
  HR
  ACCOUNT_OFFICER
  MANAGER
  SUPERVISOR
  EMPLOYEE
}

enum LeaveStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

enum LeaveType {
  ANNUAL
  SICK
  PERSONAL
  MATERNITY
  PATERNITY
  UNPAID
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  LATE
  EARLY
  REMOTE
  HALF_DAY
}

/** Employee-initiated resignation lifecycle. */
enum ResignationStatus {
  PENDING_MANAGER
  PENDING_HR
  APPROVED
  REJECTED
  WITHDRAWN
  COMPLETED
}

enum AttendanceMethod {
  WEB
  DEVICE
  MOBILE
  MANUAL
}

enum JobStatus {
  OPEN
  CLOSED
  DRAFT
  INACTIVE
}

enum ApplicationStatus {
  APPLIED
  SCREENING
  INTERVIEW
  OFFER
  HIRED
  REJECTED
}

enum InterviewStatus {
  SCHEDULED
  COMPLETED
  CANCELLED
  NO_SHOW
}

enum InterviewType {
  PHONE
  VIDEO
  ONSITE
  TECHNICAL
  FINAL
}

enum InterviewRecommendation {
  STRONG_YES
  YES
  NEUTRAL
  NO
  STRONG_NO
}

enum PayrollStatus {
  DRAFT
  PROCESSED
  PAID
}

enum ReviewStatus {
  DRAFT
  IN_PROGRESS
  COMPLETED
}

enum KpiMetricType {
  NUMBER
  PERCENTAGE
  BOOLEAN
  RATING
}

enum AppraisalCycleStatus {
  DRAFT
  ACTIVE
  CLOSED
}

enum AppraisalStatus {
  NOT_STARTED
  SELF_REVIEW
  MANAGER_REVIEW
  COMPLETED
}

enum SubscriptionStatus {
  TRIAL
  ACTIVE
  PAST_DUE
  CANCELLED
}

model Company {
  id                 String             @id @default(cuid())
  name               String
  slug               String             @unique
  logo               String?
  email              String?
  phone              String?
  address            String?
  plan               String             @default("trial")
  subscriptionStatus SubscriptionStatus @default(TRIAL)
  trialEndsAt        DateTime?
  currentPeriodEnd   DateTime?
  billingEmail       String?
  isActive           Boolean            @default(true)
  subscriptionProvider String           @default("manual")
  gatewayReference   String?
  gatewayCheckoutUrl String?
  gatewayLinkedAt    DateTime?
  isLocked           Boolean            @default(false)
  lockedAt           DateTime?
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  users         User[]
  integrations  Integration[]
  departments   Department[]
  announcements Announcement[]
  holidays      Holiday[]
  branches          Branch[]
  attendanceDevices AttendanceDevice[]
  payrollSettings   PayrollSettings[]
  attendanceSettings AttendanceSettings[]
  payrollRuns       PayrollRun[]
  attendanceArchives AttendanceArchive[]
  offboardingSettings OffboardingSettings[]
  resignationSettings ResignationSettings?
  resignations      Resignation[]
  performanceSettings PerformanceSettings[]
  kpiDefinitions    KpiDefinition[]
  appraisalCycles   AppraisalCycle[]
  recruitmentStages RecruitmentStage[]
  recruitmentTags   RecruitmentTag[]
  recruitmentSources RecruitmentSource[]
  recruitmentEmailTemplates RecruitmentEmailTemplate[]
  jobs              Job[]
  documentFolders   DocumentFolder[]
  checklistTemplates ChecklistTemplate[]
  checklistInstances ChecklistInstance[]
  portalTemplates   PortalTemplate[]
  portalDocuments   PortalDocument[]
  roleDefinitions   RoleDefinition[]
  notes             Note[]
  dailyReports      DailyReport[]
  supportTickets    SupportTicket[]
  bulkMessages      BulkMessage[]
  loans             Loan[]
  leaveSettings     LeaveSettings?
  leaveAllocations  LeaveAllocation[]
  auditLogs         AuditLog[]
  bonusSettings     BonusSettings?
  bonusTypes        BonusType[]
  bonusAwards       BonusAward[]
}

enum MessageChannel {
  SMS
  EMAIL
  WHATSAPP
}

enum MessageStatus {
  PENDING
  SENDING
  SENT
  FAILED
}

model BulkMessage {
  id          String         @id @default(cuid())
  companyId   String?
  channel     MessageChannel
  subject     String?
  message     String
  recipientType String      @default("ALL") // ALL | DEPARTMENT | CUSTOM
  departmentId String?
  recipientCount Int         @default(0)
  sentCount   Int            @default(0)
  failedCount Int            @default(0)
  status      MessageStatus  @default(PENDING)
  sentByName  String?
  sentById    String?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  company    Company?               @relation(fields: [companyId], references: [id])
  recipients BulkMessageRecipient[]

  @@index([companyId, createdAt])
  @@index([status])
}

model BulkMessageRecipient {
  id            String    @id @default(cuid())
  messageId     String
  employeeId    String
  recipientEmail String?
  recipientPhone String?
  recipientName String?
  status        MessageStatus @default(PENDING)
  error         String?
  sentAt        DateTime?
  createdAt     DateTime  @default(now())

  message BulkMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)

  @@index([messageId])
  @@index([employeeId])
}

model Notification {
  id        String    @id @default(cuid())
  userId    String
  type      String
  title     String
  message   String
  href      String
  readAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, readAt])
  @@index([userId, createdAt])
}

/// Per-user read receipts for notifications that are derived on the fly
/// (pending leave, announcements, attendance, appraisal reminders, …). Those
/// items do not have a Notification row, so their read state is stored here by
/// stable key (for example "leave-<leaveRequestId>").
model NotificationRead {
  id     String   @id @default(cuid())
  userId String
  key    String
  readAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, key])
  @@index([userId, readAt])
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  role         Role     @default(EMPLOYEE)
  companyId    String?
  /** False when a platform admin has deactivated the account. */
  isActive     Boolean  @default(true)
  /** Set when the account is archived (hidden from the active roster). */
  archivedAt   DateTime?
  suspendedAt  DateTime?
  suspendedUntil DateTime?
  suspensionReason String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  company         Company?            @relation(fields: [companyId], references: [id])
  employee        Employee?
  preferences     String?
  notifications   Notification[]
  notificationReads NotificationRead[]
  notes           Note[]
  dailyReports    DailyReport[]
  supportTicketsCreated  SupportTicket[]   @relation("SupportTicketsAuthored")
  supportTicketsAssigned SupportTicket[]   @relation("SupportTicketsAssigned")
  supportMessages        SupportMessage[]
  passwordResets  PasswordResetToken[]
}

model PasswordResetToken {
  id        String   @id @default(cuid())
  tokenHash String   @unique
  userId    String
  expiresAt DateTime
  consumedAt DateTime?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Department {
  id          String     @id @default(cuid())
  companyId   String?
  name        String
  description String?
  createdAt   DateTime   @default(now())
  employees   Employee[]
  jobs        Job[]
  kpis        KpiDefinition[]

  company Company? @relation(fields: [companyId], references: [id])

  @@unique([companyId, name])
}

/**
 * Catalog of roles shown in the People/onboarding role picker and the
 * Roles management page. Built-in roles are seeded once (companyId = null,
 * isCustom = false); admins can create their own custom roles (isCustom = true)
 * that map to a base system role for their actual permissions. Only custom
 * roles can be created/edited/deleted by admins.
 */
model RoleDefinition {
  id          String   @id @default(cuid())
  companyId   String?
  name        String
  label       String
  description String?
  baseRole    Role     @default(EMPLOYEE)
  isCustom    Boolean  @default(false)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  company   Company?   @relation(fields: [companyId], references: [id])
  employees Employee[]

  @@unique([companyId, name])
  @@index([companyId])
}

model Branch {
  id        String   @id @default(cuid())
  companyId String?
  name      String
  location  String
  timezone  String   @default("Africa/Lagos")
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company   Company?           @relation(fields: [companyId], references: [id])
  employees Employee[]
  devices   AttendanceDevice[]

  @@unique([companyId, name])
  @@index([companyId])
}

model Employee {
  id           String    @id @default(cuid())
  userId       String    @unique
  employeeCode String    @unique
  firstName    String
  middleName   String?
  lastName     String
  email        String    @unique
  phone        String?
  avatar       String?
  jobTitle         String
  employmentType   String    @default("FULL_TIME")
  departmentId     String
  branchId         String?
  roleId           String?
  biometricPin     String?
  isShiftWorker    Boolean   @default(false)
  shiftStartHour   Int?
  shiftStartMinute Int?
  managerId        String?
  hireDate         DateTime
  endDate          DateTime?
  salary           Float     @default(0)
  bankName         String?
  accountNumber    String?
  nin              String?
  address          String?
  dateOfBirth      DateTime?
  gender           String?
  cameThroughAgent Boolean   @default(false)
  agentName        String?
  status           String    @default("ACTIVE")
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  user              User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  department        Department         @relation(fields: [departmentId], references: [id])
  branch            Branch?            @relation(fields: [branchId], references: [id])
  roleDefinition    RoleDefinition?    @relation(fields: [roleId], references: [id])
  manager           Employee?          @relation("EmployeeManager", fields: [managerId], references: [id])
  directReports     Employee[]         @relation("EmployeeManager")
  managers          Employee[]         @relation("EmployeeAdditionalManagers")
  additionalReports Employee[]         @relation("EmployeeAdditionalManagers")
  leaveRequests     LeaveRequest[]
  approvedLeaves    LeaveRequest[]     @relation("LeaveApprover")
  leaveAllocations  LeaveAllocation[]
  attendanceRecords Attendance[]
  attendanceBreaks  AttendanceBreak[]
  payrollRecords    PayrollRecord[]
  payrollDeductions PayrollDeduction[]
  performanceReviews PerformanceReview[] @relation("ReviewEmployee")
  conductedReviews  PerformanceReview[] @relation("ReviewManager")
  documents         Document[]
  jobApplications   JobApplication[]   @relation("ApplicationReviewer")
  interviews        Interview[]        @relation("InterviewInterviewer")
  interviewReviews  InterviewReview[]  @relation("InterviewReviewAuthor")
  applicationEvaluations ApplicationEvaluation[] @relation("ApplicationEvaluationAuthor")
  appraisalsAsEmployee PerformanceAppraisal[] @relation("AppraisalEmployee")
  appraisalsAsManager  PerformanceAppraisal[] @relation("AppraisalManager")
  checklistInstances   ChecklistInstance[]
  assignedChecklistTasks ChecklistTask[] @relation("ChecklistTaskAssignee")
  completedChecklistTasks ChecklistTask[] @relation("ChecklistTaskCompleter")
  portalDocuments      PortalDocument[]
  notes                Note[]
  dailyReports         DailyReport[]
  loans                Loan[]
  bonusAwards          BonusAward[]
  resignations         Resignation[] @relation("ResignationEmployee")
  managedResignations  Resignation[] @relation("ResignationManager")
  reviewedResignations Resignation[] @relation("ResignationReviewer")

  @@index([branchId])
  @@index([biometricPin])
}

model LeaveRequest {
  id         String      @id @default(cuid())
  employeeId String
  type       LeaveType
  startDate  DateTime
  endDate    DateTime
  reason     String
  status     LeaveStatus @default(PENDING)
  approverId String?
  reviewNote String?
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt

  employee Employee  @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  approver Employee? @relation("LeaveApprover", fields: [approverId], references: [id])
}

model Attendance {
  id                 String            @id @default(cuid())
  employeeId         String
  date               DateTime
  checkIn            DateTime?
  checkOut           DateTime?
  status             AttendanceStatus  @default(PRESENT)
  checkInMethod      AttendanceMethod?
  checkOutMethod     AttendanceMethod?
  deviceId           String?
  deviceName         String?
  externalCheckInId  String?           @unique
  externalCheckOutId String?           @unique
  notes              String?
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @default(now()) @updatedAt

  employee Employee          @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  device   AttendanceDevice? @relation(fields: [deviceId], references: [id])
  breaks   AttendanceBreak[]

  @@unique([employeeId, date])
}

model AttendanceBreak {
  id           String    @id @default(cuid())
  employeeId   String
  attendanceId String?
  date         DateTime
  breakStart   DateTime
  breakEnd     DateTime?
  createdAt    DateTime  @default(now())

  employee   Employee    @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  attendance Attendance? @relation(fields: [attendanceId], references: [id], onDelete: SetNull)

  @@index([employeeId, date])
  @@index([attendanceId])
}

model AttendanceSettings {
  id                   String   @id @default(cuid())
  companyId            String?  @unique
  workStartHour        Int      @default(9)
  workStartMinute      Int      @default(0)
  workEndHour          Int      @default(17)
  workEndMinute        Int      @default(0)
  graceMinutes         Int      @default(15)
  breakTrackingEnabled Boolean  @default(false)
  maxBreakMinutes      Int      @default(60)
  timezone             String   @default("Africa/Lagos")
  autoRegisterDevices  Boolean  @default(false)
  autoRegisterBranchId String?
  updatedAt            DateTime @updatedAt

  company Company? @relation(fields: [companyId], references: [id])
}

/**
 * Company-wide leave allocation policy. When `allocationEnabled`, leave
 * requests are checked against each employee's yearly allowance.
 */
model LeaveSettings {
  id                String   @id @default(cuid())
  companyId         String?  @unique
  allocationEnabled Boolean  @default(false)
  defaultAnnualDays Float    @default(20)
  defaultSickDays   Float    @default(10)
  updatedAt         DateTime @updatedAt

  company Company? @relation(fields: [companyId], references: [id])
}

/**
 * Yearly leave allowance per employee per leave type. `usedDays` grows as
 * approved leave is booked; the remaining balance caps new requests.
 */
model LeaveAllocation {
  id         String    @id @default(cuid())
  companyId  String?
  employeeId String
  year       Int
  type       LeaveType
  totalDays  Float
  usedDays   Float     @default(0)
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  company  Company? @relation(fields: [companyId], references: [id])

  @@unique([employeeId, year, type])
  @@index([companyId, year])
}

/**
 * Company-wide offboarding retention: how many days to keep a deactivated
 * (offboarded) staff record before it is permanently deleted from the database.
 */
model OffboardingSettings {
  id          String  @id @default(cuid())
  companyId   String? @unique
  retentionDays Int   @default(30)
  updatedAt   DateTime @updatedAt

  company Company? @relation(fields: [companyId], references: [id])
}

/**
 * Company-wide resignation policy: statutory/contractual notice period and
 * which approval stages are required before an exit is accepted.
 */
model ResignationSettings {
  id                         String   @id @default(cuid())
  companyId                  String?  @unique
  noticePeriodDays           Int      @default(30)
  managerEndorsementRequired Boolean  @default(true)
  hrApprovalRequired         Boolean  @default(true)
  autoStartOffboarding       Boolean  @default(true)
  allowWithdrawal            Boolean  @default(true)
  updatedAt                  DateTime @updatedAt

  company Company? @relation(fields: [companyId], references: [id])
}

/**
 * An employee's resignation request. Moves through manager endorsement, HR
 * approval, and completion (which starts the exit checklist and offboards).
 */
model Resignation {
  id                      String            @id @default(cuid())
  companyId               String?
  employeeId              String
  status                  ResignationStatus @default(PENDING_MANAGER)
  reason                  String
  noticePeriodDays        Int
  requestedLastWorkingDay DateTime
  lastWorkingDay          DateTime
  managerId               String?
  managerNote             String?
  managerReviewedAt       DateTime?
  hrReviewerId            String?
  hrNote                  String?
  hrReviewedAt            DateTime?
  decidedAt               DateTime?
  completedAt             DateTime?
  withdrawnAt             DateTime?
  offboardingInstanceId   String?
  createdAt               DateTime          @default(now())
  updatedAt               DateTime          @updatedAt

  company    Company?           @relation(fields: [companyId], references: [id])
  employee   Employee           @relation("ResignationEmployee", fields: [employeeId], references: [id], onDelete: Cascade)
  manager    Employee?          @relation("ResignationManager", fields: [managerId], references: [id], onDelete: SetNull)
  hrReviewer Employee?          @relation("ResignationReviewer", fields: [hrReviewerId], references: [id], onDelete: SetNull)
  events     ResignationEvent[]

  @@index([companyId, status])
  @@index([employeeId, createdAt])
  @@index([managerId])
}

/** Immutable audit trail of every resignation decision and status change. */
model ResignationEvent {
  id            String   @id @default(cuid())
  resignationId String
  actorUserId   String?
  actorName     String
  actorRole     String?
  action        String
  fromStatus    String?
  toStatus      String?
  note          String?
  createdAt     DateTime @default(now())

  resignation Resignation @relation(fields: [resignationId], references: [id], onDelete: Cascade)

  @@index([resignationId, createdAt])
}

/**
 * Company audit trail: actions performed across every module. Written by the
 * API routes via lib/audit.ts and surfaced on /reports/audit.
 */
model AuditLog {
  id          String   @id @default(cuid())
  companyId   String?
  actorUserId String?
  actorName   String
  actorRole   String?
  action      String
  module      String
  entityId    String?
  entityLabel String?
  meta        Json?
  ipAddress   String?
  createdAt   DateTime @default(now())

  company Company? @relation(fields: [companyId], references: [id])

  @@index([companyId, createdAt])
  @@index([module, createdAt])
}

/**
 * Pointer to an attendance month archived to Cloudinary to free primary-storage space.
 * The JSON payload lives in Cloudinary; only lightweight metadata stays in the DB.
 */
model AttendanceArchive {
  id          String   @id @default(cuid())
  companyId   String?
  month       String
  publicId    String
  fileUrl     String
  recordCount Int      @default(0)
  bytes       Int      @default(0)
  createdBy   String?
  restored    Boolean  @default(false)
  restoredAt  DateTime?
  createdAt   DateTime @default(now())

  company Company? @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([companyId, month])
  @@index([companyId, createdAt])
}

model AttendanceDevice {
  id           String    @id @default(cuid())
  companyId    String?
  branchId     String?
  name         String
  location     String?
  vendor       String    @default("ZKTECO")
  serialNumber String?   @unique
  model        String?
  firmware     String?
  timezone     String?
  ipAddress    String?
  commPort     Int       @default(4370)
  apiKey       String    @unique
  isActive     Boolean   @default(true)
  lastSeenAt   DateTime?
  attStamp     String?
  opStamp      String?
  deviceInfo   String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  company  Company?                   @relation(fields: [companyId], references: [id])
  branch   Branch?                    @relation(fields: [branchId], references: [id])
  records  Attendance[]
  commands AttendanceDeviceCommand[]
  punchLogs AttendancePunchLog[]

  @@index([companyId, branchId])
}

model AttendanceDeviceCommand {
  id        String    @id @default(cuid())
  deviceId  String
  cmdId     Int
  command   String
  status    String    @default("PENDING")
  result    String?
  createdAt DateTime  @default(now())
  sentAt    DateTime?
  ackedAt   DateTime?

  device AttendanceDevice @relation(fields: [deviceId], references: [id], onDelete: Cascade)

  @@index([deviceId, status])
}

model AttendancePunchLog {
  id           String   @id @default(cuid())
  deviceId     String?
  serialNumber String
  pin          String
  punchedAt    DateTime
  statusCode   Int
  verifyType   Int?
  workCode     Int?
  processed    Boolean  @default(false)
  duplicate    Boolean  @default(false)
  attendanceId String?
  employeeId   String?
  error        String?
  rawLine      String
  createdAt    DateTime @default(now())

  device AttendanceDevice? @relation(fields: [deviceId], references: [id], onDelete: SetNull)

  @@unique([serialNumber, pin, punchedAt, statusCode])
  @@index([deviceId, punchedAt])
  @@index([serialNumber, punchedAt(sort: Desc)])
  @@index([punchedAt(sort: Desc)])
  @@index([processed, error])
}

model PayrollRecord {
  id           String        @id @default(cuid())
  employeeId   String
  payrollRunId String?
  periodStart  DateTime
  periodEnd    DateTime
  baseSalary   Float
  bonus        Float         @default(0)
  deductions   Float         @default(0)
  grossPay     Float         @default(0)
  netPay       Float
  breakdown    String?
  notes        String?
  status       PayrollStatus @default(DRAFT)
  paidAt       DateTime?
  createdAt    DateTime      @default(now())

  employee   Employee    @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  payrollRun PayrollRun? @relation(fields: [payrollRunId], references: [id], onDelete: SetNull)
  bonusAwards BonusAward[]

  @@index([payrollRunId])
  @@index([periodStart, periodEnd])
}

model PayrollRun {
  id            String        @id @default(cuid())
  companyId     String?
  periodStart   DateTime
  periodEnd     DateTime
  label         String?
  status        PayrollStatus @default(DRAFT)
  totalNet      Float         @default(0)
  totalGross    Float         @default(0)
  employeeCount Int           @default(0)
  createdByName String?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  company Company?        @relation(fields: [companyId], references: [id])
  records PayrollRecord[]

  @@index([companyId, periodStart])
}

model PayrollSettings {
  id                      String   @id @default(cuid())
  companyId               String?  @unique
  holidayAllowanceEnabled Boolean  @default(false)
  holidayAllowanceAmount  Float    @default(150)
  latenessDeductionPerDay Float    @default(25)
  absenceDeductionPerDay  Float    @default(100)
  damageDeductionEnabled  Boolean  @default(true)
  taxRatePercent          Float    @default(10)
  workingDaysPerWeek      Int      @default(5)
  proRataSalaryEnabled    Boolean  @default(true)
  overtimeEnabled         Boolean  @default(false)
  overtimeMultiplier      Float    @default(1.75)
  overtimeThresholdMinutes Int    @default(30)
  updatedAt               DateTime @updatedAt

  company Company? @relation(fields: [companyId], references: [id])
}

/**
 * Company-wide configuration for the Bonuses module. The module is disabled
 * until a company admin or HR turns it on from settings. Every rule here is
 * intentionally data-driven so companies can run very different bonus
 * programmes without code changes.
 */
model BonusSettings {
  id                     String   @id @default(cuid())
  companyId              String?  @unique
  enabled                Boolean  @default(false)
  currency               String   @default("NGN")
  payrollLineLabel       String   @default("Bonus")
  payoutSchedule         String   @default("MANUAL") // MANUAL | NEXT_PAYROLL | MONTHLY | QUARTERLY | ANNUAL
  approvalRequired       Boolean  @default(true)
  approverRole           String   @default("HR") // HR | COMPANY_ADMIN | MANAGER | ACCOUNT_OFFICER
  requireReason          Boolean  @default(true)
  allowSelfNomination    Boolean  @default(false)
  allowManagerNomination Boolean  @default(true)
  notifyEmployee         Boolean  @default(true)
  notifyApprover         Boolean  @default(true)
  autoApplyToPayroll     Boolean  @default(false)
  taxable                Boolean  @default(true)
  minServiceMonths       Int      @default(0)
  maxAwardAmount         Float?
  maxPercentOfSalary     Float?
  prorateOnLeave         Boolean  @default(false)
  defaultTypeId          String?
  eligibility            String?  // JSON: employment types, departments, branches, roles
  updatedAt              DateTime @updatedAt

  company Company? @relation(fields: [companyId], references: [id], onDelete: Cascade)
}

/**
 * A reusable bonus plan (also called a bonus type). Companies can create as
 * many as they need, each with its own calculation method, caps and rules.
 */
model BonusType {
  id                String   @id @default(cuid())
  companyId         String?
  name              String
  code              String?
  description       String?
  category          String   @default("PERFORMANCE") // PERFORMANCE | ANNUAL | RETENTION | REFERRAL | ...
  calculationMethod String   @default("FIXED") // FIXED | PERCENT_BASE_SALARY | PERCENT_GROSS | PERCENT_NET | MANUAL | TIERED
  defaultAmount     Float    @default(0)
  percentage        Float    @default(0)
  base              String   @default("BASE_SALARY") // BASE_SALARY | GROSS_PAY | NET_PAY
  maxAmount         Float?
  minServiceMonths  Int      @default(0)
  taxable           Boolean  @default(true)
  requiresApproval  Boolean  @default(true)
  isActive          Boolean  @default(true)
  sortOrder         Int      @default(0)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  company Company?     @relation(fields: [companyId], references: [id], onDelete: Cascade)
  awards  BonusAward[]

  @@index([companyId, isActive])
}

/**
 * One bonus awarded to one employee. `amount` is the final, resolved value;
 * calculation inputs are snapshotted so later plan edits never rewrite history.
 */
model BonusAward {
  id                String    @id @default(cuid())
  companyId         String?
  employeeId        String
  typeId            String?
  title             String
  description       String?
  category          String    @default("PERFORMANCE")
  amount            Float
  currency          String    @default("NGN")
  calculationMethod String    @default("MANUAL")
  baseAmount        Float?
  percentage        Float?
  periodStart       DateTime?
  periodEnd         DateTime?
  awardDate         DateTime  @default(now())
  status            String    @default("DRAFT") // DRAFT | PENDING | APPROVED | SCHEDULED | PAID | REJECTED | CANCELLED
  reason            String?
  notes             String?
  createdById       String?
  createdByName     String?
  approvedById      String?
  approvedByName    String?
  approvedAt        DateTime?
  rejectionReason   String?
  paidAt            DateTime?
  payrollRecordId   String?
  metadata          String?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  company       Company?       @relation(fields: [companyId], references: [id], onDelete: SetNull)
  employee      Employee       @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  type          BonusType?     @relation(fields: [typeId], references: [id], onDelete: SetNull)
  payrollRecord PayrollRecord? @relation(fields: [payrollRecordId], references: [id], onDelete: SetNull)

  @@index([companyId, status])
  @@index([employeeId, status])
  @@index([awardDate])
  @@index([typeId])
}

model PayrollDeduction {
  id               String    @id @default(cuid())
  companyId        String?
  employeeId       String
  amount           Float
  reason           String
  periodMonth      String?
  status           String    @default("PENDING")
  appliedPayrollId String?
  loanId           String?
  loanInstallmentId String?
  createdById      String?
  createdByName    String
  createdAt        DateTime  @default(now())
  appliedAt        DateTime?

  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@index([employeeId, status])
  @@index([companyId, status])
  @@index([loanId])
  @@index([loanInstallmentId])
}

model Loan {
  id                 String    @id @default(cuid())
  companyId          String?
  employeeId         String
  amount             Float
  interestRate       Float     @default(0)
  monthlyInstallment Float
  tenureMonths       Int
  startMonth         String
  totalRepayable     Float
  purpose            String?
  note               String?
  status             String    @default("PENDING")
  requestedById      String?
  requestedByName    String
  approvedById       String?
  approvedByName     String?
  approvedAt         DateTime?
  decisionNote       String?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  employee    Employee          @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  company     Company?          @relation(fields: [companyId], references: [id])
  installments LoanInstallment[]

  @@index([companyId, status])
  @@index([employeeId, status])
}

model LoanInstallment {
  id               String    @id @default(cuid())
  loanId           String
  seq              Int
  month            String
  amount           Float
  status           String    @default("SCHEDULED")
  deductionId      String?
  appliedPayrollId String?
  paidAt           DateTime?
  createdAt        DateTime  @default(now())

  loan Loan @relation(fields: [loanId], references: [id], onDelete: Cascade)

  @@unique([loanId, seq])
  @@index([month, status])
  @@index([deductionId])
}

model Job {
  id                   String    @id @default(cuid())
  title                String
  departmentId         String
  companyId            String?
  location             String
  office               String?
  type                 String
  quantity             Int       @default(1)
  expectedClosingDate  DateTime?
  salaryMin            Float?
  salaryMax            Float?
  description          String
  requirements         String
  responsibilities     String?
  benefits             String?
  hiringTeam           String?
  pipelineStages       String?
  status               JobStatus @default(OPEN)
  postedAt             DateTime  @default(now())
  closedAt             DateTime?
  createdAt            DateTime  @default(now())

  company      Company?         @relation(fields: [companyId], references: [id])
  department   Department       @relation(fields: [departmentId], references: [id])
  applications JobApplication[]
}

model JobApplication {
  id            String            @id @default(cuid())
  jobId         String
  firstName     String
  lastName      String
  email         String
  phone         String?
  photoUrl      String?
  resumeUrl     String?
  coverLetter   String?
  source        String?
  pipelineStage String            @default("Applied")
  status        ApplicationStatus @default(APPLIED)
  reviewerId    String?
  tagId         String?
  notes         String?
  appliedAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt

  job          Job                     @relation(fields: [jobId], references: [id], onDelete: Cascade)
  reviewer     Employee?               @relation("ApplicationReviewer", fields: [reviewerId], references: [id])
  tag          RecruitmentTag?         @relation(fields: [tagId], references: [id])
  interviews   Interview[]
  activities   ApplicationActivity[]
  evaluations  ApplicationEvaluation[]
}

model Interview {
  id                    String          @id @default(cuid())
  applicationId         String
  interviewerId         String
  scheduledAt           DateTime
  durationMinutes       Int             @default(60)
  type                  InterviewType   @default(VIDEO)
  status                InterviewStatus @default(SCHEDULED)
  location              String?
  googleCalendarEventId String?
  googleMeetLink        String?
  calendarSynced        Boolean         @default(false)
  notes                 String?
  createdAt             DateTime        @default(now())
  updatedAt             DateTime        @updatedAt

  application JobApplication    @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  interviewer Employee          @relation("InterviewInterviewer", fields: [interviewerId], references: [id])
  reviews     InterviewReview[]
}

model InterviewReview {
  id             String                  @id @default(cuid())
  interviewId    String
  reviewerId     String
  rating         Int
  strengths      String?
  weaknesses     String?
  recommendation InterviewRecommendation
  notes          String?
  createdAt      DateTime                @default(now())

  interview Interview @relation(fields: [interviewId], references: [id], onDelete: Cascade)
  reviewer  Employee  @relation("InterviewReviewAuthor", fields: [reviewerId], references: [id])
}

model RecruitmentStage {
  id        String  @id @default(cuid())
  companyId String?
  name      String
  sortOrder Int     @default(0)
  color     String  @default("blue")

  company Company? @relation(fields: [companyId], references: [id])

  @@unique([companyId, name])
}

model RecruitmentTag {
  id        String  @id @default(cuid())
  companyId String?
  name      String
  color     String  @default("violet")

  company      Company?         @relation(fields: [companyId], references: [id])
  applications JobApplication[]

  @@unique([companyId, name])
}

model RecruitmentSource {
  id        String  @id @default(cuid())
  companyId String?
  name      String

  company Company? @relation(fields: [companyId], references: [id])

  @@unique([companyId, name])
}

model RecruitmentEmailTemplate {
  id        String   @id @default(cuid())
  companyId String?
  name      String
  subject   String
  body      String
  stage     String?
  updatedAt DateTime @updatedAt

  company Company? @relation(fields: [companyId], references: [id])
}

model ApplicationActivity {
  id            String   @id @default(cuid())
  applicationId String
  actorName     String?
  type          String
  title         String
  message       String?
  metadata      String?
  createdAt     DateTime @default(now())

  application JobApplication @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  @@index([applicationId, createdAt])
}

model ApplicationEvaluation {
  id            String   @id @default(cuid())
  applicationId String
  reviewerId    String
  rating        String
  feedback      String?
  createdAt     DateTime @default(now())

  application JobApplication @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  reviewer    Employee       @relation("ApplicationEvaluationAuthor", fields: [reviewerId], references: [id])

  @@index([applicationId])
}

model GoogleIntegration {
  id           String    @id @default("default")
  accessToken  String?
  refreshToken String?
  expiryDate   DateTime?
  email        String?
  calendarId   String    @default("primary")
  connectedAt  DateTime?
  updatedAt    DateTime  @updatedAt
}

enum IntegrationProvider {
  GOOGLE_WORKSPACE
  ZOHO_PEOPLE
  ZOHO_RECRUIT
  ZOHO_BOOKS
  ZOHO_SIGN
  ZOHO_MAIL
}

enum IntegrationStatus {
  DISCONNECTED
  CONNECTED
  ERROR
  SYNCING
}

model Integration {
  id            String              @id @default(cuid())
  companyId     String?
  provider      IntegrationProvider
  status        IntegrationStatus   @default(DISCONNECTED)
  accessToken   String?
  refreshToken  String?
  expiryDate    DateTime?
  accountEmail  String?
  accountId     String?
  scopes        String?
  metadata      String?
  webhookSecret String?
  lastSyncAt    DateTime?
  lastError     String?
  connectedAt   DateTime?
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt

  company  Company?              @relation(fields: [companyId], references: [id])
  syncLogs IntegrationSyncLog[]

  @@unique([companyId, provider])
}

model IntegrationSyncLog {
  id            String   @id @default(cuid())
  integrationId String
  direction     String
  eventType     String
  summary       String?
  payload       String?
  status        String   @default("success")
  createdAt     DateTime @default(now())

  integration Integration @relation(fields: [integrationId], references: [id], onDelete: Cascade)
}

model PerformanceReview {
  id           String       @id @default(cuid())
  employeeId   String
  managerId    String
  period       String
  rating       Int?
  goals        String
  achievements String?
  feedback     String?
  status       ReviewStatus @default(DRAFT)
  reviewDate   DateTime?
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  employee Employee @relation("ReviewEmployee", fields: [employeeId], references: [id], onDelete: Cascade)
  manager  Employee @relation("ReviewManager", fields: [managerId], references: [id])
}

model PerformanceSettings {
  id                       String   @id @default(cuid())
  companyId                String?  @unique
  ratingScaleMax           Int      @default(5)
  announceOnActivate       Boolean  @default(true)
  notifyOnActivate         Boolean  @default(true)
  requireSelfBeforeManager Boolean  @default(true)
  autoOverallFromKpis      Boolean  @default(true)
  updatedAt                DateTime @updatedAt

  company Company? @relation(fields: [companyId], references: [id], onDelete: Cascade)
}

model KpiDefinition {
  id           String        @id @default(cuid())
  companyId    String?
  title        String
  description  String?
  metricType   KpiMetricType @default(RATING)
  targetValue  Float?
  weight       Float         @default(1)
  departmentId String?
  roleFilter   String?
  isActive     Boolean       @default(true)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  company    Company?            @relation(fields: [companyId], references: [id], onDelete: Cascade)
  department Department?         @relation(fields: [departmentId], references: [id])
  cycleLinks AppraisalCycleKpi[]
  scores     AppraisalKpiScore[]

  @@index([companyId, isActive])
}

model AppraisalCycle {
  id                    String               @id @default(cuid())
  companyId             String?
  name                  String
  period                String
  description           String?
  startDate             DateTime
  endDate               DateTime
  selfReviewDeadline    DateTime?
  managerReviewDeadline DateTime?
  status                AppraisalCycleStatus @default(DRAFT)
  includeAllEmployees   Boolean              @default(true)
  departmentIds         String?
  roleFilters           String?
  createdAt             DateTime             @default(now())
  updatedAt             DateTime             @updatedAt

  company    Company?               @relation(fields: [companyId], references: [id], onDelete: Cascade)
  kpis       AppraisalCycleKpi[]
  appraisals PerformanceAppraisal[]

  @@index([companyId, status])
}

model AppraisalCycleKpi {
  id      String @id @default(cuid())
  cycleId String
  kpiId   String
  weight  Float  @default(1)

  cycle AppraisalCycle @relation(fields: [cycleId], references: [id], onDelete: Cascade)
  kpi   KpiDefinition  @relation(fields: [kpiId], references: [id], onDelete: Cascade)

  @@unique([cycleId, kpiId])
}

model PerformanceAppraisal {
  id         String          @id @default(cuid())
  cycleId    String
  employeeId String
  managerId  String
  status     AppraisalStatus @default(NOT_STARTED)

  selfRating       Int?
  selfAchievements String?
  selfComments     String?
  selfSubmittedAt  DateTime?

  managerRating      Int?
  managerFeedback    String?
  managerSubmittedAt DateTime?

  overallRating Int?
  completedAt   DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  cycle     AppraisalCycle      @relation(fields: [cycleId], references: [id], onDelete: Cascade)
  employee  Employee            @relation("AppraisalEmployee", fields: [employeeId], references: [id], onDelete: Cascade)
  manager   Employee            @relation("AppraisalManager", fields: [managerId], references: [id])
  kpiScores AppraisalKpiScore[]

  @@unique([cycleId, employeeId])
}

model AppraisalKpiScore {
  id           String  @id @default(cuid())
  appraisalId  String
  kpiId        String
  selfScore    Float?
  selfNotes    String?
  managerScore Float?
  managerNotes String?

  appraisal PerformanceAppraisal @relation(fields: [appraisalId], references: [id], onDelete: Cascade)
  kpi       KpiDefinition        @relation(fields: [kpiId], references: [id], onDelete: Cascade)

  @@unique([appraisalId, kpiId])
}

model DocumentFolder {
  id            String   @id @default(cuid())
  companyId     String?
  name          String
  description   String?
  createdByName String
  shareScope    String   @default("EVERYONE")
  shareTargets  String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @default(now()) @updatedAt

  company   Company?   @relation(fields: [companyId], references: [id])
  documents Document[]
}

model Document {
  id            String   @id @default(cuid())
  companyId     String?
  folderId      String?
  employeeId    String?
  title         String
  category      String
  fileUrl       String?
  fileName      String?
  fileSize      Int?
  uploadedBy    String
  shareScope    String   @default("EVERYONE")
  shareTargets  String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @default(now()) @updatedAt

  folder   DocumentFolder? @relation(fields: [folderId], references: [id], onDelete: Cascade)
  employee Employee?       @relation(fields: [employeeId], references: [id], onDelete: SetNull)
}

model ChecklistTemplate {
  id          String   @id @default(cuid())
  companyId   String?
  type        String
  name        String
  description String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  company   Company?               @relation(fields: [companyId], references: [id])
  tasks     ChecklistTemplateTask[]
  instances ChecklistInstance[]
}

model ChecklistTemplateTask {
  id                  String  @id @default(cuid())
  templateId          String
  title               String
  description         String?
  taskType            String  @default("CHECKBOX")
  assigneeType        String  @default("ANYONE")
  assigneeId          String?
  dueDaysOffset       Int?
  sortOrder           Int     @default(0)
  requiredDocuments   Json    @default("[]")

  template ChecklistTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
}

model ChecklistInstance {
  id         String    @id @default(cuid())
  companyId  String?
  templateId String?
  type       String
  employeeId String
  startDate  DateTime
  endDate    DateTime?
  status     String    @default("IN_PROGRESS")
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  company  Company?           @relation(fields: [companyId], references: [id])
  template ChecklistTemplate? @relation(fields: [templateId], references: [id], onDelete: SetNull)
  employee Employee           @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  tasks    ChecklistTask[]
}

model ChecklistTask {
  id                  String    @id @default(cuid())
  instanceId          String
  title               String
  description         String?
  taskType            String    @default("CHECKBOX")
  status              String    @default("PENDING")
  priority            String    @default("MEDIUM")
  dueDate             DateTime?
  assigneeId          String?
  assigneeType        String?
  sortOrder           Int       @default(0)
  completedAt         DateTime?
  completedById       String?
  requiredDocuments   Json      @default("[]")
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  instance    ChecklistInstance      @relation(fields: [instanceId], references: [id], onDelete: Cascade)
  assignee    Employee?              @relation("ChecklistTaskAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  completedBy Employee?              @relation("ChecklistTaskCompleter", fields: [completedById], references: [id], onDelete: SetNull)
  comments    ChecklistTaskComment[]
  files       ChecklistTaskFile[]
}

model ChecklistTaskFile {
  id             String   @id @default(cuid())
  taskId         String
  documentName   String
  fileName       String
  fileUrl        String
  publicId       String?
  fileSize       Int?
  mimeType       String?
  uploadedById   String?
  uploadedByName String
  createdAt      DateTime @default(now())

  task ChecklistTask @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@index([taskId])
}

model ChecklistTaskComment {
  id         String   @id @default(cuid())
  taskId     String
  authorId   String?
  authorName String
  content    String
  createdAt  DateTime @default(now())

  task ChecklistTask @relation(fields: [taskId], references: [id], onDelete: Cascade)
}

model Announcement {
  id        String   @id @default(cuid())
  companyId String?
  title     String
  content   String
  author    String
  priority  String   @default("NORMAL")
  createdAt DateTime @default(now())

  company Company? @relation(fields: [companyId], references: [id])
}

model Holiday {
  id        String   @id @default(cuid())
  companyId String?
  name      String
  date      DateTime
  type      String   @default("Public")
  createdAt DateTime @default(now())

  company Company? @relation(fields: [companyId], references: [id])
}

/**
 * Personal / shared notes & note-taker.
 * Scope: PRIVATE notes are owned by userId and visible only to that user;
 * SHARED notes belong to a company and are visible to everyone in the org.
 * Every role can take their own notes; SHARED creation is limited to content
 * admins (Company Admin / HR).
 */
model Note {
  id         String   @id @default(cuid())
  companyId  String?
  userId     String
  employeeId String?
  title      String
  content    String
  folder     String?
  column     String   @default("TODO")
  pinned     Boolean  @default(false)
  color      String   @default("violet")
  scope      String   @default("PRIVATE") // PRIVATE | SHARED
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  company  Company?  @relation(fields: [companyId], references: [id])
  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  employee Employee? @relation(fields: [employeeId], references: [id], onDelete: SetNull)

  @@index([userId, scope])
  @@index([companyId, scope])
  @@index([pinned])
}

/**
 * Manager-authored daily report. Like a Google Doc: created from a blank page
 * or a starter template, then edited with rich text. Reports are private to
 * the manager who wrote them. Status: DRAFT | SUBMITTED.
 */
model DailyReport {
  id         String   @id @default(cuid())
  companyId  String?
  userId     String
  employeeId String?
  title      String
  content    String   @default("")
  template   String   @default("blank")
  status     String   @default("DRAFT")
  reportDate DateTime @default(now())
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  company  Company?  @relation(fields: [companyId], references: [id], onDelete: SetNull)
  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  employee Employee? @relation(fields: [employeeId], references: [id], onDelete: SetNull)

  @@index([userId, reportDate])
  @@index([userId, updatedAt])
  @@index([companyId, status])
}

/**
 * Support desk ticket — GitHub-style issue between a company admin (requester)
 * and a super admin (support agent). Status drives the drag-and-drop board:
 * OPEN | IN_PROGRESS | RESOLVED | CLOSED.
 */
model SupportTicket {
  id          String   @id @default(cuid())
  number      Int      @default(autoincrement())
  companyId   String
  authorId    String
  subject     String
  description String
  category    String   @default("Other")
  priority    String   @default("Medium") // Low | Medium | High | Urgent
  status      String   @default("OPEN")   // OPEN | IN_PROGRESS | RESOLVED | CLOSED
  assigneeId  String?
  resolvedAt  DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  company  Company           @relation(fields: [companyId], references: [id])
  author   User              @relation("SupportTicketsAuthored", fields: [authorId], references: [id])
  assignee User?             @relation("SupportTicketsAssigned", fields: [assigneeId], references: [id])
  messages SupportMessage[]

  @@index([companyId, status])
  @@index([status, updatedAt])
}

model SupportMessage {
  id        String   @id @default(cuid())
  ticketId  String
  authorId  String
  body      String
  createdAt DateTime @default(now())

  ticket SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  author User          @relation(fields: [authorId], references: [id])

  @@index([ticketId, createdAt])
}

/** Singleton platform config (id = "platform"). Currency defaults to Naira. */
model PlatformSettings {
  id           String   @id @default("platform")
  currencyCode String   @default("NGN")
  updatedAt    DateTime @updatedAt
  updatedById  String?
}

/** HR letter or form template created in the portal. */
model PortalTemplate {
  id            String   @id @default(cuid())
  companyId     String?
  kind          String
  category      String
  title         String
  description   String?
  body          String
  fieldsJson    String   @default("[]")
  isPublished   Boolean  @default(true)
  createdByName String
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  company   Company?         @relation(fields: [companyId], references: [id])
  documents PortalDocument[]

  @@index([companyId, kind])
}

/** Issued letter or assigned/submitted form. */
model PortalDocument {
  id              String    @id @default(cuid())
  companyId       String?
  templateId      String?
  employeeId      String?
  kind            String
  title           String
  body            String
  fieldValuesJson String    @default("{}")
  status          String    @default("DRAFT")
  issuedByName    String?
  issuedAt        DateTime?
  acknowledgedAt  DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  company  Company?        @relation(fields: [companyId], references: [id])
  template PortalTemplate? @relation(fields: [templateId], references: [id], onDelete: SetNull)
  employee Employee?       @relation(fields: [employeeId], references: [id], onDelete: SetNull)

  @@index([companyId, kind])
  @@index([employeeId, status])
}
