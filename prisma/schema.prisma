generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  SUPER_ADMIN
  COMPANY_ADMIN
  HR
  MANAGER
  SUPERVISOR
  EMPLOYEE
}

enum LeaveStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

enum LeaveType {
  ANNUAL
  SICK
  PERSONAL
  MATERNITY
  PATERNITY
  UNPAID
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  LATE
  REMOTE
  HALF_DAY
}

enum AttendanceMethod {
  WEB
  DEVICE
  MOBILE
  MANUAL
}

enum JobStatus {
  OPEN
  CLOSED
  DRAFT
  INACTIVE
}

enum ApplicationStatus {
  APPLIED
  SCREENING
  INTERVIEW
  OFFER
  HIRED
  REJECTED
}

enum InterviewStatus {
  SCHEDULED
  COMPLETED
  CANCELLED
  NO_SHOW
}

enum InterviewType {
  PHONE
  VIDEO
  ONSITE
  TECHNICAL
  FINAL
}

enum InterviewRecommendation {
  STRONG_YES
  YES
  NEUTRAL
  NO
  STRONG_NO
}

enum PayrollStatus {
  DRAFT
  PROCESSED
  PAID
}

enum ReviewStatus {
  DRAFT
  IN_PROGRESS
  COMPLETED
}

enum KpiMetricType {
  NUMBER
  PERCENTAGE
  BOOLEAN
  RATING
}

enum AppraisalCycleStatus {
  DRAFT
  ACTIVE
  CLOSED
}

enum AppraisalStatus {
  NOT_STARTED
  SELF_REVIEW
  MANAGER_REVIEW
  COMPLETED
}

enum SubscriptionStatus {
  TRIAL
  ACTIVE
  PAST_DUE
  CANCELLED
}

model Company {
  id                 String             @id @default(cuid())
  name               String
  slug               String             @unique
  plan               String             @default("trial")
  subscriptionStatus SubscriptionStatus @default(TRIAL)
  trialEndsAt        DateTime?
  currentPeriodEnd   DateTime?
  billingEmail       String?
  isActive           Boolean            @default(true)
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  users         User[]
  integrations  Integration[]
  departments   Department[]
  announcements Announcement[]
  holidays      Holiday[]
  attendanceDevices AttendanceDevice[]
  payrollSettings   PayrollSettings[]
  recruitmentStages RecruitmentStage[]
  recruitmentTags   RecruitmentTag[]
  recruitmentSources RecruitmentSource[]
  recruitmentEmailTemplates RecruitmentEmailTemplate[]
  jobs              Job[]
  documentFolders   DocumentFolder[]
  checklistTemplates ChecklistTemplate[]
  checklistInstances ChecklistInstance[]
}

model Notification {
  id        String    @id @default(cuid())
  userId    String
  type      String
  title     String
  message   String
  href      String
  readAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, readAt])
  @@index([userId, createdAt])
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  role         Role     @default(EMPLOYEE)
  companyId    String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  company       Company?       @relation(fields: [companyId], references: [id])
  employee      Employee?
  preferences   String?
  notifications Notification[]
}

model Department {
  id          String     @id @default(cuid())
  companyId   String?
  name        String
  description String?
  createdAt   DateTime   @default(now())
  employees   Employee[]
  jobs        Job[]
  kpis        KpiDefinition[]

  company Company? @relation(fields: [companyId], references: [id])

  @@unique([companyId, name])
}

model Employee {
  id           String    @id @default(cuid())
  userId       String    @unique
  employeeCode String    @unique
  firstName    String
  lastName     String
  email        String    @unique
  phone        String?
  avatar       String?
  jobTitle     String
  departmentId String
  managerId    String?
  hireDate     DateTime
  salary       Float     @default(0)
  address      String?
  dateOfBirth  DateTime?
  gender       String?
  status       String    @default("ACTIVE")
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  user              User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  department        Department         @relation(fields: [departmentId], references: [id])
  manager           Employee?          @relation("EmployeeManager", fields: [managerId], references: [id])
  directReports     Employee[]         @relation("EmployeeManager")
  leaveRequests     LeaveRequest[]
  approvedLeaves    LeaveRequest[]     @relation("LeaveApprover")
  attendanceRecords Attendance[]
  payrollRecords    PayrollRecord[]
  performanceReviews PerformanceReview[] @relation("ReviewEmployee")
  conductedReviews  PerformanceReview[] @relation("ReviewManager")
  documents         Document[]
  jobApplications   JobApplication[]   @relation("ApplicationReviewer")
  interviews        Interview[]        @relation("InterviewInterviewer")
  interviewReviews  InterviewReview[]  @relation("InterviewReviewAuthor")
  applicationEvaluations ApplicationEvaluation[] @relation("ApplicationEvaluationAuthor")
  appraisalsAsEmployee PerformanceAppraisal[] @relation("AppraisalEmployee")
  appraisalsAsManager  PerformanceAppraisal[] @relation("AppraisalManager")
  checklistInstances   ChecklistInstance[]
  assignedChecklistTasks ChecklistTask[] @relation("ChecklistTaskAssignee")
  completedChecklistTasks ChecklistTask[] @relation("ChecklistTaskCompleter")
}

model LeaveRequest {
  id         String      @id @default(cuid())
  employeeId String
  type       LeaveType
  startDate  DateTime
  endDate    DateTime
  reason     String
  status     LeaveStatus @default(PENDING)
  approverId String?
  reviewNote String?
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt

  employee Employee  @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  approver Employee? @relation("LeaveApprover", fields: [approverId], references: [id])
}

model Attendance {
  id                 String            @id @default(cuid())
  employeeId         String
  date               DateTime
  checkIn            DateTime?
  checkOut           DateTime?
  status             AttendanceStatus  @default(PRESENT)
  checkInMethod      AttendanceMethod?
  checkOutMethod     AttendanceMethod?
  deviceId           String?
  deviceName         String?
  externalCheckInId  String?           @unique
  externalCheckOutId String?           @unique
  notes              String?
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @default(now()) @updatedAt

  employee Employee          @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  device   AttendanceDevice? @relation(fields: [deviceId], references: [id])

  @@unique([employeeId, date])
}

model AttendanceDevice {
  id         String   @id @default(cuid())
  companyId  String?
  name       String
  location   String?
  apiKey     String   @unique
  isActive   Boolean  @default(true)
  lastSeenAt DateTime?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  company Company? @relation(fields: [companyId], references: [id])
  records Attendance[]
}

model PayrollRecord {
  id          String        @id @default(cuid())
  employeeId  String
  periodStart DateTime
  periodEnd   DateTime
  baseSalary  Float
  bonus       Float         @default(0)
  deductions  Float         @default(0)
  grossPay    Float         @default(0)
  netPay      Float
  breakdown   String?
  notes       String?
  status      PayrollStatus @default(DRAFT)
  paidAt      DateTime?
  createdAt   DateTime      @default(now())

  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
}

model PayrollSettings {
  id                      String   @id @default(cuid())
  companyId               String?  @unique
  holidayAllowanceEnabled Boolean  @default(false)
  holidayAllowanceAmount  Float    @default(150)
  latenessDeductionPerDay Float    @default(25)
  absenceDeductionPerDay  Float    @default(100)
  damageDeductionEnabled  Boolean  @default(true)
  taxRatePercent          Float    @default(10)
  updatedAt               DateTime @updatedAt

  company Company? @relation(fields: [companyId], references: [id])
}

model Job {
  id                   String    @id @default(cuid())
  title                String
  departmentId         String
  companyId            String?
  location             String
  office               String?
  type                 String
  quantity             Int       @default(1)
  expectedClosingDate  DateTime?
  salaryMin            Float?
  salaryMax            Float?
  description          String
  requirements         String
  responsibilities     String?
  benefits             String?
  hiringTeam           String?
  pipelineStages       String?
  status               JobStatus @default(OPEN)
  postedAt             DateTime  @default(now())
  closedAt             DateTime?
  createdAt            DateTime  @default(now())

  company      Company?         @relation(fields: [companyId], references: [id])
  department   Department       @relation(fields: [departmentId], references: [id])
  applications JobApplication[]
}

model JobApplication {
  id            String            @id @default(cuid())
  jobId         String
  firstName     String
  lastName      String
  email         String
  phone         String?
  photoUrl      String?
  resumeUrl     String?
  coverLetter   String?
  source        String?
  pipelineStage String            @default("Applied")
  status        ApplicationStatus @default(APPLIED)
  reviewerId    String?
  tagId         String?
  notes         String?
  appliedAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt

  job          Job                     @relation(fields: [jobId], references: [id], onDelete: Cascade)
  reviewer     Employee?               @relation("ApplicationReviewer", fields: [reviewerId], references: [id])
  tag          RecruitmentTag?         @relation(fields: [tagId], references: [id])
  interviews   Interview[]
  activities   ApplicationActivity[]
  evaluations  ApplicationEvaluation[]
}

model Interview {
  id                    String          @id @default(cuid())
  applicationId         String
  interviewerId         String
  scheduledAt           DateTime
  durationMinutes       Int             @default(60)
  type                  InterviewType   @default(VIDEO)
  status                InterviewStatus @default(SCHEDULED)
  location              String?
  googleCalendarEventId String?
  googleMeetLink        String?
  calendarSynced        Boolean         @default(false)
  notes                 String?
  createdAt             DateTime        @default(now())
  updatedAt             DateTime        @updatedAt

  application JobApplication    @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  interviewer Employee          @relation("InterviewInterviewer", fields: [interviewerId], references: [id])
  reviews     InterviewReview[]
}

model InterviewReview {
  id             String                  @id @default(cuid())
  interviewId    String
  reviewerId     String
  rating         Int
  strengths      String?
  weaknesses     String?
  recommendation InterviewRecommendation
  notes          String?
  createdAt      DateTime                @default(now())

  interview Interview @relation(fields: [interviewId], references: [id], onDelete: Cascade)
  reviewer  Employee  @relation("InterviewReviewAuthor", fields: [reviewerId], references: [id])
}

model RecruitmentStage {
  id        String  @id @default(cuid())
  companyId String?
  name      String
  sortOrder Int     @default(0)
  color     String  @default("blue")

  company Company? @relation(fields: [companyId], references: [id])

  @@unique([companyId, name])
}

model RecruitmentTag {
  id        String  @id @default(cuid())
  companyId String?
  name      String
  color     String  @default("violet")

  company      Company?         @relation(fields: [companyId], references: [id])
  applications JobApplication[]

  @@unique([companyId, name])
}

model RecruitmentSource {
  id        String  @id @default(cuid())
  companyId String?
  name      String

  company Company? @relation(fields: [companyId], references: [id])

  @@unique([companyId, name])
}

model RecruitmentEmailTemplate {
  id        String   @id @default(cuid())
  companyId String?
  name      String
  subject   String
  body      String
  stage     String?
  updatedAt DateTime @updatedAt

  company Company? @relation(fields: [companyId], references: [id])
}

model ApplicationActivity {
  id            String   @id @default(cuid())
  applicationId String
  actorName     String?
  type          String
  title         String
  message       String?
  metadata      String?
  createdAt     DateTime @default(now())

  application JobApplication @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  @@index([applicationId, createdAt])
}

model ApplicationEvaluation {
  id            String   @id @default(cuid())
  applicationId String
  reviewerId    String
  rating        String
  feedback      String?
  createdAt     DateTime @default(now())

  application JobApplication @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  reviewer    Employee       @relation("ApplicationEvaluationAuthor", fields: [reviewerId], references: [id])

  @@index([applicationId])
}

model GoogleIntegration {
  id           String    @id @default("default")
  accessToken  String?
  refreshToken String?
  expiryDate   DateTime?
  email        String?
  calendarId   String    @default("primary")
  connectedAt  DateTime?
  updatedAt    DateTime  @updatedAt
}

enum IntegrationProvider {
  GOOGLE_WORKSPACE
  ZOHO_PEOPLE
  ZOHO_RECRUIT
  ZOHO_BOOKS
  ZOHO_SIGN
  ZOHO_MAIL
}

enum IntegrationStatus {
  DISCONNECTED
  CONNECTED
  ERROR
  SYNCING
}

model Integration {
  id            String              @id @default(cuid())
  companyId     String?
  provider      IntegrationProvider
  status        IntegrationStatus   @default(DISCONNECTED)
  accessToken   String?
  refreshToken  String?
  expiryDate    DateTime?
  accountEmail  String?
  accountId     String?
  scopes        String?
  metadata      String?
  webhookSecret String?
  lastSyncAt    DateTime?
  lastError     String?
  connectedAt   DateTime?
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt

  company  Company?              @relation(fields: [companyId], references: [id])
  syncLogs IntegrationSyncLog[]

  @@unique([companyId, provider])
}

model IntegrationSyncLog {
  id            String   @id @default(cuid())
  integrationId String
  direction     String
  eventType     String
  summary       String?
  payload       String?
  status        String   @default("success")
  createdAt     DateTime @default(now())

  integration Integration @relation(fields: [integrationId], references: [id], onDelete: Cascade)
}

model PerformanceReview {
  id           String       @id @default(cuid())
  employeeId   String
  managerId    String
  period       String
  rating       Int?
  goals        String
  achievements String?
  feedback     String?
  status       ReviewStatus @default(DRAFT)
  reviewDate   DateTime?
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  employee Employee @relation("ReviewEmployee", fields: [employeeId], references: [id], onDelete: Cascade)
  manager  Employee @relation("ReviewManager", fields: [managerId], references: [id])
}

model KpiDefinition {
  id           String        @id @default(cuid())
  title        String
  description  String?
  metricType   KpiMetricType @default(RATING)
  targetValue  Float?
  weight       Float         @default(1)
  departmentId String?
  roleFilter   String?
  isActive     Boolean       @default(true)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  department Department?         @relation(fields: [departmentId], references: [id])
  cycleLinks AppraisalCycleKpi[]
  scores     AppraisalKpiScore[]
}

model AppraisalCycle {
  id                    String               @id @default(cuid())
  name                  String
  period                String
  description           String?
  startDate             DateTime
  endDate               DateTime
  selfReviewDeadline    DateTime?
  managerReviewDeadline DateTime?
  status                AppraisalCycleStatus @default(DRAFT)
  includeAllEmployees   Boolean              @default(true)
  departmentIds         String?
  roleFilters           String?
  createdAt             DateTime             @default(now())
  updatedAt             DateTime             @updatedAt

  kpis       AppraisalCycleKpi[]
  appraisals PerformanceAppraisal[]
}

model AppraisalCycleKpi {
  id      String @id @default(cuid())
  cycleId String
  kpiId   String
  weight  Float  @default(1)

  cycle AppraisalCycle @relation(fields: [cycleId], references: [id], onDelete: Cascade)
  kpi   KpiDefinition  @relation(fields: [kpiId], references: [id], onDelete: Cascade)

  @@unique([cycleId, kpiId])
}

model PerformanceAppraisal {
  id         String          @id @default(cuid())
  cycleId    String
  employeeId String
  managerId  String
  status     AppraisalStatus @default(NOT_STARTED)

  selfRating       Int?
  selfAchievements String?
  selfComments     String?
  selfSubmittedAt  DateTime?

  managerRating      Int?
  managerFeedback    String?
  managerSubmittedAt DateTime?

  overallRating Int?
  completedAt   DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  cycle     AppraisalCycle      @relation(fields: [cycleId], references: [id], onDelete: Cascade)
  employee  Employee            @relation("AppraisalEmployee", fields: [employeeId], references: [id], onDelete: Cascade)
  manager   Employee            @relation("AppraisalManager", fields: [managerId], references: [id])
  kpiScores AppraisalKpiScore[]

  @@unique([cycleId, employeeId])
}

model AppraisalKpiScore {
  id           String  @id @default(cuid())
  appraisalId  String
  kpiId        String
  selfScore    Float?
  selfNotes    String?
  managerScore Float?
  managerNotes String?

  appraisal PerformanceAppraisal @relation(fields: [appraisalId], references: [id], onDelete: Cascade)
  kpi       KpiDefinition        @relation(fields: [kpiId], references: [id], onDelete: Cascade)

  @@unique([appraisalId, kpiId])
}

model DocumentFolder {
  id            String   @id @default(cuid())
  companyId     String?
  name          String
  description   String?
  createdByName String
  shareScope    String   @default("EVERYONE")
  shareTargets  String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @default(now()) @updatedAt

  company   Company?   @relation(fields: [companyId], references: [id])
  documents Document[]
}

model Document {
  id            String   @id @default(cuid())
  companyId     String?
  folderId      String?
  employeeId    String?
  title         String
  category      String
  fileUrl       String?
  fileName      String?
  fileSize      Int?
  uploadedBy    String
  shareScope    String   @default("EVERYONE")
  shareTargets  String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @default(now()) @updatedAt

  folder   DocumentFolder? @relation(fields: [folderId], references: [id], onDelete: Cascade)
  employee Employee?       @relation(fields: [employeeId], references: [id], onDelete: SetNull)
}

model ChecklistTemplate {
  id          String   @id @default(cuid())
  companyId   String?
  type        String
  name        String
  description String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  company   Company?               @relation(fields: [companyId], references: [id])
  tasks     ChecklistTemplateTask[]
  instances ChecklistInstance[]
}

model ChecklistTemplateTask {
  id            String  @id @default(cuid())
  templateId    String
  title         String
  description   String?
  taskType      String  @default("CHECKBOX")
  assigneeType  String  @default("EMPLOYEE")
  assigneeId    String?
  dueDaysOffset Int?
  sortOrder     Int     @default(0)

  template ChecklistTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
}

model ChecklistInstance {
  id         String    @id @default(cuid())
  companyId  String?
  templateId String?
  type       String
  employeeId String
  startDate  DateTime
  endDate    DateTime?
  status     String    @default("IN_PROGRESS")
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  company  Company?           @relation(fields: [companyId], references: [id])
  template ChecklistTemplate? @relation(fields: [templateId], references: [id], onDelete: SetNull)
  employee Employee           @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  tasks    ChecklistTask[]
}

model ChecklistTask {
  id            String    @id @default(cuid())
  instanceId    String
  title         String
  description   String?
  taskType      String    @default("CHECKBOX")
  status        String    @default("PENDING")
  priority      String    @default("MEDIUM")
  dueDate       DateTime?
  assigneeId    String?
  assigneeType  String?
  sortOrder     Int       @default(0)
  completedAt   DateTime?
  completedById String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  instance    ChecklistInstance      @relation(fields: [instanceId], references: [id], onDelete: Cascade)
  assignee    Employee?              @relation("ChecklistTaskAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  completedBy Employee?              @relation("ChecklistTaskCompleter", fields: [completedById], references: [id], onDelete: SetNull)
  comments    ChecklistTaskComment[]
}

model ChecklistTaskComment {
  id         String   @id @default(cuid())
  taskId     String
  authorId   String?
  authorName String
  content    String
  createdAt  DateTime @default(now())

  task ChecklistTask @relation(fields: [taskId], references: [id], onDelete: Cascade)
}

model Announcement {
  id        String   @id @default(cuid())
  companyId String?
  title     String
  content   String
  author    String
  priority  String   @default("NORMAL")
  createdAt DateTime @default(now())

  company Company? @relation(fields: [companyId], references: [id])
}

model Holiday {
  id        String   @id @default(cuid())
  companyId String?
  name      String
  date      DateTime
  type      String   @default("Public")
  createdAt DateTime @default(now())

  company Company? @relation(fields: [companyId], references: [id])
}
