generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Role {
  SUPER_ADMIN
  COMPANY_ADMIN
  HR
  ACCOUNT_OFFICER
  MANAGER
  SUPERVISOR
  EMPLOYEE
}

enum LeaveStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

enum LeaveType {
  ANNUAL
  SICK
  PERSONAL
  MATERNITY
  PATERNITY
  UNPAID
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  LATE
  EARLY
  REMOTE
  HALF_DAY
}

enum AttendanceMethod {
  WEB
  DEVICE
  MOBILE
  MANUAL
}

enum JobStatus {
  OPEN
  CLOSED
  DRAFT
  INACTIVE
}

enum ApplicationStatus {
  APPLIED
  SCREENING
  INTERVIEW
  OFFER
  HIRED
  REJECTED
}

enum InterviewStatus {
  SCHEDULED
  COMPLETED
  CANCELLED
  NO_SHOW
}

enum InterviewType {
  PHONE
  VIDEO
  ONSITE
  TECHNICAL
  FINAL
}

enum InterviewRecommendation {
  STRONG_YES
  YES
  NEUTRAL
  NO
  STRONG_NO
}

enum PayrollStatus {
  DRAFT
  PROCESSED
  PAID
}

enum ReviewStatus {
  DRAFT
  IN_PROGRESS
  COMPLETED
}

enum KpiMetricType {
  NUMBER
  PERCENTAGE
  BOOLEAN
  RATING
}

enum AppraisalCycleStatus {
  DRAFT
  ACTIVE
  CLOSED
}

enum AppraisalStatus {
  NOT_STARTED
  SELF_REVIEW
  MANAGER_REVIEW
  COMPLETED
}

enum SubscriptionStatus {
  TRIAL
  ACTIVE
  PAST_DUE
  CANCELLED
}

model Company {
  id                 String             @id @default(cuid())
  name               String
  slug               String             @unique
  logo               String?
  email              String?
  phone              String?
  address            String?
  plan               String             @default("trial")
  subscriptionStatus SubscriptionStatus @default(TRIAL)
  trialEndsAt        DateTime?
  currentPeriodEnd   DateTime?
  billingEmail       String?
  isActive           Boolean            @default(true)
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  users         User[]
  integrations  Integration[]
  departments   Department[]
  announcements Announcement[]
  holidays      Holiday[]
  branches          Branch[]
  attendanceDevices AttendanceDevice[]
  payrollSettings   PayrollSettings[]
  attendanceSettings AttendanceSettings[]
  payrollRuns       PayrollRun[]
  attendanceArchives AttendanceArchive[]
  offboardingSettings OffboardingSettings[]
  performanceSettings PerformanceSettings[]
  kpiDefinitions    KpiDefinition[]
  appraisalCycles   AppraisalCycle[]
  recruitmentStages RecruitmentStage[]
  recruitmentTags   RecruitmentTag[]
  recruitmentSources RecruitmentSource[]
  recruitmentEmailTemplates RecruitmentEmailTemplate[]
  jobs              Job[]
  documentFolders   DocumentFolder[]
  checklistTemplates ChecklistTemplate[]
  checklistInstances ChecklistInstance[]
  portalTemplates   PortalTemplate[]
  portalDocuments   PortalDocument[]
  roleDefinitions   RoleDefinition[]
  notes             Note[]
}

model Notification {
  id        String    @id @default(cuid())
  userId    String
  type      String
  title     String
  message   String
  href      String
  readAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, readAt])
  @@index([userId, createdAt])
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  role         Role     @default(EMPLOYEE)
  companyId    String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  company       Company?       @relation(fields: [companyId], references: [id])
  employee      Employee?
  preferences   String?
  notifications Notification[]
  notes         Note[]
}

model Department {
  id          String     @id @default(cuid())
  companyId   String?
  name        String
  description String?
  createdAt   DateTime   @default(now())
  employees   Employee[]
  jobs        Job[]
  kpis        KpiDefinition[]

  company Company? @relation(fields: [companyId], references: [id])

  @@unique([companyId, name])
}

/**
 * Catalog of roles shown in the People/onboarding role picker and the
 * Roles management page. Built-in roles are seeded once (companyId = null,
 * isCustom = false); admins can create their own custom roles (isCustom = true)
 * that map to a base system role for their actual permissions. Only custom
 * roles can be created/edited/deleted by admins.
 */
model RoleDefinition {
  id          String   @id @default(cuid())
  companyId   String?
  name        String
  label       String
  description String?
  baseRole    Role     @default(EMPLOYEE)
  isCustom    Boolean  @default(false)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  company   Company?   @relation(fields: [companyId], references: [id])
  employees Employee[]

  @@unique([companyId, name])
  @@index([companyId])
}

model Branch {
  id        String   @id @default(cuid())
  companyId String?
  name      String
  location  String
  timezone  String   @default("Africa/Lagos")
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company   Company?           @relation(fields: [companyId], references: [id])
  employees Employee[]
  devices   AttendanceDevice[]

  @@unique([companyId, name])
  @@index([companyId])
}

model Employee {
  id           String    @id @default(cuid())
  userId       String    @unique
  employeeCode String    @unique
  firstName    String
  lastName     String
  email        String    @unique
  phone        String?
  avatar       String?
  jobTitle         String
  employmentType   String    @default("FULL_TIME")
  departmentId     String
  branchId         String?
  roleId           String?
  biometricPin     String?
  isShiftWorker    Boolean   @default(false)
  shiftStartHour   Int?
  shiftStartMinute Int?
  managerId        String?
  hireDate         DateTime
  endDate          DateTime?
  salary           Float     @default(0)
  address          String?
  dateOfBirth      DateTime?
  gender           String?
  status           String    @default("ACTIVE")
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  user              User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  department        Department         @relation(fields: [departmentId], references: [id])
  branch            Branch?            @relation(fields: [branchId], references: [id])
  roleDefinition    RoleDefinition?    @relation(fields: [roleId], references: [id])
  manager           Employee?          @relation("EmployeeManager", fields: [managerId], references: [id])
  directReports     Employee[]         @relation("EmployeeManager")
  leaveRequests     LeaveRequest[]
  approvedLeaves    LeaveRequest[]     @relation("LeaveApprover")
  attendanceRecords Attendance[]
  attendanceBreaks  AttendanceBreak[]
  payrollRecords    PayrollRecord[]
  payrollDeductions PayrollDeduction[]
  performanceReviews PerformanceReview[] @relation("ReviewEmployee")
  conductedReviews  PerformanceReview[] @relation("ReviewManager")
  documents         Document[]
  jobApplications   JobApplication[]   @relation("ApplicationReviewer")
  interviews        Interview[]        @relation("InterviewInterviewer")
  interviewReviews  InterviewReview[]  @relation("InterviewReviewAuthor")
  applicationEvaluations ApplicationEvaluation[] @relation("ApplicationEvaluationAuthor")
  appraisalsAsEmployee PerformanceAppraisal[] @relation("AppraisalEmployee")
  appraisalsAsManager  PerformanceAppraisal[] @relation("AppraisalManager")
  checklistInstances   ChecklistInstance[]
  assignedChecklistTasks ChecklistTask[] @relation("ChecklistTaskAssignee")
  completedChecklistTasks ChecklistTask[] @relation("ChecklistTaskCompleter")
  portalDocuments      PortalDocument[]
  notes                Note[]

  @@index([branchId])
  @@index([biometricPin])
}

model LeaveRequest {
  id         String      @id @default(cuid())
  employeeId String
  type       LeaveType
  startDate  DateTime
  endDate    DateTime
  reason     String
  status     LeaveStatus @default(PENDING)
  approverId String?
  reviewNote String?
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt

  employee Employee  @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  approver Employee? @relation("LeaveApprover", fields: [approverId], references: [id])
}

model Attendance {
  id                 String            @id @default(cuid())
  employeeId         String
  date               DateTime
  checkIn            DateTime?
  checkOut           DateTime?
  status             AttendanceStatus  @default(PRESENT)
  checkInMethod      AttendanceMethod?
  checkOutMethod     AttendanceMethod?
  deviceId           String?
  deviceName         String?
  externalCheckInId  String?           @unique
  externalCheckOutId String?           @unique
  notes              String?
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @default(now()) @updatedAt

  employee Employee          @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  device   AttendanceDevice? @relation(fields: [deviceId], references: [id])
  breaks   AttendanceBreak[]

  @@unique([employeeId, date])
}

model AttendanceBreak {
  id           String    @id @default(cuid())
  employeeId   String
  attendanceId String?
  date         DateTime
  breakStart   DateTime
  breakEnd     DateTime?
  createdAt    DateTime  @default(now())

  employee   Employee    @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  attendance Attendance? @relation(fields: [attendanceId], references: [id], onDelete: SetNull)

  @@index([employeeId, date])
  @@index([attendanceId])
}

model AttendanceSettings {
  id                   String   @id @default(cuid())
  companyId            String?  @unique
  workStartHour        Int      @default(9)
  workStartMinute      Int      @default(0)
  graceMinutes         Int      @default(15)
  breakTrackingEnabled Boolean  @default(false)
  maxBreakMinutes      Int      @default(60)
  timezone             String   @default("Africa/Lagos")
  autoRegisterDevices  Boolean  @default(false)
  autoRegisterBranchId String?
  updatedAt            DateTime @updatedAt

  company Company? @relation(fields: [companyId], references: [id])
}

/**
 * Company-wide offboarding retention: how many days to keep a deactivated
 * (offboarded) staff record before it is permanently deleted from the database.
 */
model OffboardingSettings {
  id          String  @id @default(cuid())
  companyId   String? @unique
  retentionDays Int   @default(30)
  updatedAt   DateTime @updatedAt

  company Company? @relation(fields: [companyId], references: [id])
}

/**
 * Pointer to an attendance month archived to Cloudinary to free primary-storage space.
 * The JSON payload lives in Cloudinary; only lightweight metadata stays in the DB.
 */
model AttendanceArchive {
  id          String   @id @default(cuid())
  companyId   String?
  month       String
  publicId    String
  fileUrl     String
  recordCount Int      @default(0)
  bytes       Int      @default(0)
  createdBy   String?
  restored    Boolean  @default(false)
  restoredAt  DateTime?
  createdAt   DateTime @default(now())

  company Company? @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([companyId, month])
  @@index([companyId, createdAt])
}

model AttendanceDevice {
  id           String    @id @default(cuid())
  companyId    String?
  branchId     String?
  name         String
  location     String?
  vendor       String    @default("ZKTECO")
  serialNumber String?   @unique
  model        String?
  firmware     String?
  timezone     String?
  ipAddress    String?
  commPort     Int       @default(4370)
  apiKey       String    @unique
  isActive     Boolean   @default(true)
  lastSeenAt   DateTime?
  attStamp     String?
  opStamp      String?
  deviceInfo   String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  company  Company?                   @relation(fields: [companyId], references: [id])
  branch   Branch?                    @relation(fields: [branchId], references: [id])
  records  Attendance[]
  commands AttendanceDeviceCommand[]
  punchLogs AttendancePunchLog[]

  @@index([companyId, branchId])
}

model AttendanceDeviceCommand {
  id        String    @id @default(cuid())
  deviceId  String
  cmdId     Int
  command   String
  status    String    @default("PENDING")
  result    String?
  createdAt DateTime  @default(now())
  sentAt    DateTime?
  ackedAt   DateTime?

  device AttendanceDevice @relation(fields: [deviceId], references: [id], onDelete: Cascade)

  @@index([deviceId, status])
}

model AttendancePunchLog {
  id           String   @id @default(cuid())
  deviceId     String?
  serialNumber String
  pin          String
  punchedAt    DateTime
  statusCode   Int
  verifyType   Int?
  workCode     Int?
  processed    Boolean  @default(false)
  duplicate    Boolean  @default(false)
  attendanceId String?
  employeeId   String?
  error        String?
  rawLine      String
  createdAt    DateTime @default(now())

  device AttendanceDevice? @relation(fields: [deviceId], references: [id], onDelete: SetNull)

  @@unique([serialNumber, pin, punchedAt, statusCode])
  @@index([deviceId, punchedAt])
  @@index([serialNumber, punchedAt(sort: Desc)])
  @@index([punchedAt(sort: Desc)])
  @@index([processed, error])
}

model PayrollRecord {
  id           String        @id @default(cuid())
  employeeId   String
  payrollRunId String?
  periodStart  DateTime
  periodEnd    DateTime
  baseSalary   Float
  bonus        Float         @default(0)
  deductions   Float         @default(0)
  grossPay     Float         @default(0)
  netPay       Float
  breakdown    String?
  notes        String?
  status       PayrollStatus @default(DRAFT)
  paidAt       DateTime?
  createdAt    DateTime      @default(now())

  employee   Employee    @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  payrollRun PayrollRun? @relation(fields: [payrollRunId], references: [id], onDelete: SetNull)

  @@index([payrollRunId])
  @@index([periodStart, periodEnd])
}

model PayrollRun {
  id            String        @id @default(cuid())
  companyId     String?
  periodStart   DateTime
  periodEnd     DateTime
  label         String?
  status        PayrollStatus @default(DRAFT)
  totalNet      Float         @default(0)
  totalGross    Float         @default(0)
  employeeCount Int           @default(0)
  createdByName String?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  company Company?        @relation(fields: [companyId], references: [id])
  records PayrollRecord[]

  @@index([companyId, periodStart])
}

model PayrollSettings {
  id                      String   @id @default(cuid())
  companyId               String?  @unique
  holidayAllowanceEnabled Boolean  @default(false)
  holidayAllowanceAmount  Float    @default(150)
  latenessDeductionPerDay Float    @default(25)
  absenceDeductionPerDay  Float    @default(100)
  damageDeductionEnabled  Boolean  @default(true)
  taxRatePercent          Float    @default(10)
  workingDaysPerWeek      Int      @default(5)
  proRataSalaryEnabled    Boolean  @default(true)
  updatedAt               DateTime @updatedAt

  company Company? @relation(fields: [companyId], references: [id])
}

model PayrollDeduction {
  id               String    @id @default(cuid())
  companyId        String?
  employeeId       String
  amount           Float
  reason           String
  periodMonth      String?
  status           String    @default("PENDING")
  appliedPayrollId String?
  createdById      String?
  createdByName    String
  createdAt        DateTime  @default(now())
  appliedAt        DateTime?

  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@index([employeeId, status])
  @@index([companyId, status])
}

model Job {
  id                   String    @id @default(cuid())
  title                String
  departmentId         String
  companyId            String?
  location             String
  office               String?
  type                 String
  quantity             Int       @default(1)
  expectedClosingDate  DateTime?
  salaryMin            Float?
  salaryMax            Float?
  description          String
  requirements         String
  responsibilities     String?
  benefits             String?
  hiringTeam           String?
  pipelineStages       String?
  status               JobStatus @default(OPEN)
  postedAt             DateTime  @default(now())
  closedAt             DateTime?
  createdAt            DateTime  @default(now())

  company      Company?         @relation(fields: [companyId], references: [id])
  department   Department       @relation(fields: [departmentId], references: [id])
  applications JobApplication[]
}

model JobApplication {
  id            String            @id @default(cuid())
  jobId         String
  firstName     String
  lastName      String
  email         String
  phone         String?
  photoUrl      String?
  resumeUrl     String?
  coverLetter   String?
  source        String?
  pipelineStage String            @default("Applied")
  status        ApplicationStatus @default(APPLIED)
  reviewerId    String?
  tagId         String?
  notes         String?
  appliedAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt

  job          Job                     @relation(fields: [jobId], references: [id], onDelete: Cascade)
  reviewer     Employee?               @relation("ApplicationReviewer", fields: [reviewerId], references: [id])
  tag          RecruitmentTag?         @relation(fields: [tagId], references: [id])
  interviews   Interview[]
  activities   ApplicationActivity[]
  evaluations  ApplicationEvaluation[]
}

model Interview {
  id                    String          @id @default(cuid())
  applicationId         String
  interviewerId         String
  scheduledAt           DateTime
  durationMinutes       Int             @default(60)
  type                  InterviewType   @default(VIDEO)
  status                InterviewStatus @default(SCHEDULED)
  location              String?
  googleCalendarEventId String?
  googleMeetLink        String?
  calendarSynced        Boolean         @default(false)
  notes                 String?
  createdAt             DateTime        @default(now())
  updatedAt             DateTime        @updatedAt

  application JobApplication    @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  interviewer Employee          @relation("InterviewInterviewer", fields: [interviewerId], references: [id])
  reviews     InterviewReview[]
}

model InterviewReview {
  id             String                  @id @default(cuid())
  interviewId    String
  reviewerId     String
  rating         Int
  strengths      String?
  weaknesses     String?
  recommendation InterviewRecommendation
  notes          String?
  createdAt      DateTime                @default(now())

  interview Interview @relation(fields: [interviewId], references: [id], onDelete: Cascade)
  reviewer  Employee  @relation("InterviewReviewAuthor", fields: [reviewerId], references: [id])
}

model RecruitmentStage {
  id        String  @id @default(cuid())
  companyId String?
  name      String
  sortOrder Int     @default(0)
  color     String  @default("blue")

  company Company? @relation(fields: [companyId], references: [id])

  @@unique([companyId, name])
}

model RecruitmentTag {
  id        String  @id @default(cuid())
  companyId String?
  name      String
  color     String  @default("violet")

  company      Company?         @relation(fields: [companyId], references: [id])
  applications JobApplication[]

  @@unique([companyId, name])
}

model RecruitmentSource {
  id        String  @id @default(cuid())
  companyId String?
  name      String

  company Company? @relation(fields: [companyId], references: [id])

  @@unique([companyId, name])
}

model RecruitmentEmailTemplate {
  id        String   @id @default(cuid())
  companyId String?
  name      String
  subject   String
  body      String
  stage     String?
  updatedAt DateTime @updatedAt

  company Company? @relation(fields: [companyId], references: [id])
}

model ApplicationActivity {
  id            String   @id @default(cuid())
  applicationId String
  actorName     String?
  type          String
  title         String
  message       String?
  metadata      String?
  createdAt     DateTime @default(now())

  application JobApplication @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  @@index([applicationId, createdAt])
}

model ApplicationEvaluation {
  id            String   @id @default(cuid())
  applicationId String
  reviewerId    String
  rating        String
  feedback      String?
  createdAt     DateTime @default(now())

  application JobApplication @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  reviewer    Employee       @relation("ApplicationEvaluationAuthor", fields: [reviewerId], references: [id])

  @@index([applicationId])
}

model GoogleIntegration {
  id           String    @id @default("default")
  accessToken  String?
  refreshToken String?
  expiryDate   DateTime?
  email        String?
  calendarId   String    @default("primary")
  connectedAt  DateTime?
  updatedAt    DateTime  @updatedAt
}

enum IntegrationProvider {
  GOOGLE_WORKSPACE
  ZOHO_PEOPLE
  ZOHO_RECRUIT
  ZOHO_BOOKS
  ZOHO_SIGN
  ZOHO_MAIL
}

enum IntegrationStatus {
  DISCONNECTED
  CONNECTED
  ERROR
  SYNCING
}

model Integration {
  id            String              @id @default(cuid())
  companyId     String?
  provider      IntegrationProvider
  status        IntegrationStatus   @default(DISCONNECTED)
  accessToken   String?
  refreshToken  String?
  expiryDate    DateTime?
  accountEmail  String?
  accountId     String?
  scopes        String?
  metadata      String?
  webhookSecret String?
  lastSyncAt    DateTime?
  lastError     String?
  connectedAt   DateTime?
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt

  company  Company?              @relation(fields: [companyId], references: [id])
  syncLogs IntegrationSyncLog[]

  @@unique([companyId, provider])
}

model IntegrationSyncLog {
  id            String   @id @default(cuid())
  integrationId String
  direction     String
  eventType     String
  summary       String?
  payload       String?
  status        String   @default("success")
  createdAt     DateTime @default(now())

  integration Integration @relation(fields: [integrationId], references: [id], onDelete: Cascade)
}

model PerformanceReview {
  id           String       @id @default(cuid())
  employeeId   String
  managerId    String
  period       String
  rating       Int?
  goals        String
  achievements String?
  feedback     String?
  status       ReviewStatus @default(DRAFT)
  reviewDate   DateTime?
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  employee Employee @relation("ReviewEmployee", fields: [employeeId], references: [id], onDelete: Cascade)
  manager  Employee @relation("ReviewManager", fields: [managerId], references: [id])
}

model PerformanceSettings {
  id                       String   @id @default(cuid())
  companyId                String?  @unique
  ratingScaleMax           Int      @default(5)
  announceOnActivate       Boolean  @default(true)
  notifyOnActivate         Boolean  @default(true)
  requireSelfBeforeManager Boolean  @default(true)
  autoOverallFromKpis      Boolean  @default(true)
  updatedAt                DateTime @updatedAt

  company Company? @relation(fields: [companyId], references: [id], onDelete: Cascade)
}

model KpiDefinition {
  id           String        @id @default(cuid())
  companyId    String?
  title        String
  description  String?
  metricType   KpiMetricType @default(RATING)
  targetValue  Float?
  weight       Float         @default(1)
  departmentId String?
  roleFilter   String?
  isActive     Boolean       @default(true)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  company    Company?            @relation(fields: [companyId], references: [id], onDelete: Cascade)
  department Department?         @relation(fields: [departmentId], references: [id])
  cycleLinks AppraisalCycleKpi[]
  scores     AppraisalKpiScore[]

  @@index([companyId, isActive])
}

model AppraisalCycle {
  id                    String               @id @default(cuid())
  companyId             String?
  name                  String
  period                String
  description           String?
  startDate             DateTime
  endDate               DateTime
  selfReviewDeadline    DateTime?
  managerReviewDeadline DateTime?
  status                AppraisalCycleStatus @default(DRAFT)
  includeAllEmployees   Boolean              @default(true)
  departmentIds         String?
  roleFilters           String?
  createdAt             DateTime             @default(now())
  updatedAt             DateTime             @updatedAt

  company    Company?               @relation(fields: [companyId], references: [id], onDelete: Cascade)
  kpis       AppraisalCycleKpi[]
  appraisals PerformanceAppraisal[]

  @@index([companyId, status])
}

model AppraisalCycleKpi {
  id      String @id @default(cuid())
  cycleId String
  kpiId   String
  weight  Float  @default(1)

  cycle AppraisalCycle @relation(fields: [cycleId], references: [id], onDelete: Cascade)
  kpi   KpiDefinition  @relation(fields: [kpiId], references: [id], onDelete: Cascade)

  @@unique([cycleId, kpiId])
}

model PerformanceAppraisal {
  id         String          @id @default(cuid())
  cycleId    String
  employeeId String
  managerId  String
  status     AppraisalStatus @default(NOT_STARTED)

  selfRating       Int?
  selfAchievements String?
  selfComments     String?
  selfSubmittedAt  DateTime?

  managerRating      Int?
  managerFeedback    String?
  managerSubmittedAt DateTime?

  overallRating Int?
  completedAt   DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  cycle     AppraisalCycle      @relation(fields: [cycleId], references: [id], onDelete: Cascade)
  employee  Employee            @relation("AppraisalEmployee", fields: [employeeId], references: [id], onDelete: Cascade)
  manager   Employee            @relation("AppraisalManager", fields: [managerId], references: [id])
  kpiScores AppraisalKpiScore[]

  @@unique([cycleId, employeeId])
}

model AppraisalKpiScore {
  id           String  @id @default(cuid())
  appraisalId  String
  kpiId        String
  selfScore    Float?
  selfNotes    String?
  managerScore Float?
  managerNotes String?

  appraisal PerformanceAppraisal @relation(fields: [appraisalId], references: [id], onDelete: Cascade)
  kpi       KpiDefinition        @relation(fields: [kpiId], references: [id], onDelete: Cascade)

  @@unique([appraisalId, kpiId])
}

model DocumentFolder {
  id            String   @id @default(cuid())
  companyId     String?
  name          String
  description   String?
  createdByName String
  shareScope    String   @default("EVERYONE")
  shareTargets  String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @default(now()) @updatedAt

  company   Company?   @relation(fields: [companyId], references: [id])
  documents Document[]
}

model Document {
  id            String   @id @default(cuid())
  companyId     String?
  folderId      String?
  employeeId    String?
  title         String
  category      String
  fileUrl       String?
  fileName      String?
  fileSize      Int?
  uploadedBy    String
  shareScope    String   @default("EVERYONE")
  shareTargets  String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @default(now()) @updatedAt

  folder   DocumentFolder? @relation(fields: [folderId], references: [id], onDelete: Cascade)
  employee Employee?       @relation(fields: [employeeId], references: [id], onDelete: SetNull)
}

model ChecklistTemplate {
  id          String   @id @default(cuid())
  companyId   String?
  type        String
  name        String
  description String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  company   Company?               @relation(fields: [companyId], references: [id])
  tasks     ChecklistTemplateTask[]
  instances ChecklistInstance[]
}

model ChecklistTemplateTask {
  id                  String  @id @default(cuid())
  templateId          String
  title               String
  description         String?
  taskType            String  @default("CHECKBOX")
  assigneeType        String  @default("ANYONE")
  assigneeId          String?
  dueDaysOffset       Int?
  sortOrder           Int     @default(0)
  requiredDocuments   Json    @default("[]")

  template ChecklistTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
}

model ChecklistInstance {
  id         String    @id @default(cuid())
  companyId  String?
  templateId String?
  type       String
  employeeId String
  startDate  DateTime
  endDate    DateTime?
  status     String    @default("IN_PROGRESS")
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  company  Company?           @relation(fields: [companyId], references: [id])
  template ChecklistTemplate? @relation(fields: [templateId], references: [id], onDelete: SetNull)
  employee Employee           @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  tasks    ChecklistTask[]
}

model ChecklistTask {
  id                  String    @id @default(cuid())
  instanceId          String
  title               String
  description         String?
  taskType            String    @default("CHECKBOX")
  status              String    @default("PENDING")
  priority            String    @default("MEDIUM")
  dueDate             DateTime?
  assigneeId          String?
  assigneeType        String?
  sortOrder           Int       @default(0)
  completedAt         DateTime?
  completedById       String?
  requiredDocuments   Json      @default("[]")
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  instance    ChecklistInstance      @relation(fields: [instanceId], references: [id], onDelete: Cascade)
  assignee    Employee?              @relation("ChecklistTaskAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  completedBy Employee?              @relation("ChecklistTaskCompleter", fields: [completedById], references: [id], onDelete: SetNull)
  comments    ChecklistTaskComment[]
  files       ChecklistTaskFile[]
}

model ChecklistTaskFile {
  id             String   @id @default(cuid())
  taskId         String
  documentName   String
  fileName       String
  fileUrl        String
  publicId       String?
  fileSize       Int?
  mimeType       String?
  uploadedById   String?
  uploadedByName String
  createdAt      DateTime @default(now())

  task ChecklistTask @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@index([taskId])
}

model ChecklistTaskComment {
  id         String   @id @default(cuid())
  taskId     String
  authorId   String?
  authorName String
  content    String
  createdAt  DateTime @default(now())

  task ChecklistTask @relation(fields: [taskId], references: [id], onDelete: Cascade)
}

model Announcement {
  id        String   @id @default(cuid())
  companyId String?
  title     String
  content   String
  author    String
  priority  String   @default("NORMAL")
  createdAt DateTime @default(now())

  company Company? @relation(fields: [companyId], references: [id])
}

model Holiday {
  id        String   @id @default(cuid())
  companyId String?
  name      String
  date      DateTime
  type      String   @default("Public")
  createdAt DateTime @default(now())

  company Company? @relation(fields: [companyId], references: [id])
}

/**
 * Personal / shared notes & note-taker.
 * Scope: PRIVATE notes are owned by userId and visible only to that user;
 * SHARED notes belong to a company and are visible to everyone in the org.
 * Every role can take their own notes; SHARED creation is limited to content
 * admins (Company Admin / HR).
 */
model Note {
  id         String   @id @default(cuid())
  companyId  String?
  userId     String
  employeeId String?
  title      String
  content    String
  folder     String?
  column     String   @default("TODO")
  pinned     Boolean  @default(false)
  color      String   @default("violet")
  scope      String   @default("PRIVATE") // PRIVATE | SHARED
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  company  Company?  @relation(fields: [companyId], references: [id])
  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  employee Employee? @relation(fields: [employeeId], references: [id], onDelete: SetNull)

  @@index([userId, scope])
  @@index([companyId, scope])
  @@index([pinned])
}

/** Singleton platform config (id = "platform"). Currency defaults to Naira. */
model PlatformSettings {
  id           String   @id @default("platform")
  currencyCode String   @default("NGN")
  updatedAt    DateTime @updatedAt
  updatedById  String?
}

/** HR letter or form template created in the portal. */
model PortalTemplate {
  id            String   @id @default(cuid())
  companyId     String?
  kind          String
  category      String
  title         String
  description   String?
  body          String
  fieldsJson    String   @default("[]")
  isPublished   Boolean  @default(true)
  createdByName String
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  company   Company?         @relation(fields: [companyId], references: [id])
  documents PortalDocument[]

  @@index([companyId, kind])
}

/** Issued letter or assigned/submitted form. */
model PortalDocument {
  id              String    @id @default(cuid())
  companyId       String?
  templateId      String?
  employeeId      String?
  kind            String
  title           String
  body            String
  fieldValuesJson String    @default("{}")
  status          String    @default("DRAFT")
  issuedByName    String?
  issuedAt        DateTime?
  acknowledgedAt  DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  company  Company?        @relation(fields: [companyId], references: [id])
  template PortalTemplate? @relation(fields: [templateId], references: [id], onDelete: SetNull)
  employee Employee?       @relation(fields: [employeeId], references: [id], onDelete: SetNull)

  @@index([companyId, kind])
  @@index([employeeId, status])
}
